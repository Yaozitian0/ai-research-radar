# Copy to .env and fill in the values you need.
#
# NOTE: nothing loads .env automatically — export the variables in your shell
# before running any script (e.g. `set -a; source .env; set +a`).
# In CI these are provided as GitHub Actions secrets.
#
# The radar is zero-cost: no LLM keys, no paid APIs. Everything below is
# optional; unset values degrade gracefully.

# ---------------------------------------------------------------------------
# GitHub API (optional)
# ---------------------------------------------------------------------------

# Raises GitHub search/trending rate limits. In GitHub Actions the built-in
# secrets.GITHUB_TOKEN is injected automatically — no setup needed.
# GITHUB_TOKEN=ghp_xxxxx

# ---------------------------------------------------------------------------
# Notifications (optional; skipped silently when unset)
# ---------------------------------------------------------------------------

# Feishu / Lark custom-bot webhook — `pnpm notify:feishu`.
# Set as the repository secret FEISHU_WEBHOOK in GitHub Actions.
# Comma-separated list also accepted. Never commit real webhook URLs.
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx

# Base URL used to build report links in notifications
# PAGES_URL=https://yaozitian0.github.io/ai-research-radar